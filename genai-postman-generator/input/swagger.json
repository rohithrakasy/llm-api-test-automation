{
  "openapi": "3.0.0",
  "info": {
    "title": "Auth API",
    "version": "1.0"
  },
  "paths": {
    "/api/auth/login": {
      "post": {
        "summary": "User Login",
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "email": "user@example.com",
                "password": "Password123"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful"
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    }
  }
}